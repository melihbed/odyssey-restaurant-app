{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "gen:openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "hono": "^4.7.4",
    "@hono/zod-openapi": "^0.18.4",
    "@scalar/hono-api-reference": "^0.5.168",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "@neondatabase/serverless": "^0.10.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250124.0",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "wrangler": "^3.106.0",
    "dotenv": "^16.4.7",
    "@types/node": "^22.10.5"
  }
}
