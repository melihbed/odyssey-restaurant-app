{
  "expo": {
    "name": "Odyssey Restaurant",
    "slug": "odyssey-restaurant",
    "version": "1.0.0",
    "scheme": "odyssey-restaurant",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-splash-screen"
    ]
  }
}
